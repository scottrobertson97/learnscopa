---
import { href, routePath } from '../lib/urls';
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; eyebrow?: string; intro: string }
const { title, description, eyebrow = 'The Scopa handbook', intro } = Astro.props;
const currentPath = routePath(Astro.url.pathname);
---
<BaseLayout title={title} description={description} allowAds={currentPath === '/rules'}>
  <header class="guide-header container"><a class="breadcrumb" href={href("/")}>Home <span aria-hidden="true">/</span></a><p class="eyebrow">{eyebrow}</p><h1>{title}<span class="text-terracotta">.</span></h1><p class="lede">{intro}</p></header>
  <div class="guide-grid container"><aside class="guide-nav"><p class="eyebrow">Keep this handy</p><nav aria-label="Handbook"><a href={href("/learn")}>Learn by playing <span aria-hidden="true">↗</span></a><a href={href("/rules")} aria-current={currentPath === '/rules' ? 'page' : undefined}>Complete rules</a><a href={href("/scoring")} aria-current={currentPath === '/scoring' ? 'page' : undefined}>Scoring explained</a><a href={href("/cards")} aria-current={currentPath === '/cards' ? 'page' : undefined}>Meet the deck</a></nav><p class="small">Our reference game: traditional two-player Scopa, played to 11.</p><slot name="aside" /></aside><article class="prose"><slot /></article></div>
</BaseLayout>
