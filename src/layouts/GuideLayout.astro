---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; description: string; eyebrow?: string; intro: string }
const { title, description, eyebrow = 'The Scopa handbook', intro } = Astro.props;
---
<BaseLayout title={title} description={description} allowAds={Astro.url.pathname === '/rules'}>
  <header class="guide-header container"><a class="breadcrumb" href="/">Home <span aria-hidden="true">/</span></a><p class="eyebrow">{eyebrow}</p><h1>{title}<span class="text-terracotta">.</span></h1><p class="lede">{intro}</p></header>
  <div class="guide-grid container"><aside class="guide-nav"><p class="eyebrow">Keep this handy</p><nav aria-label="Handbook"><a href="/learn">Learn by playing <span aria-hidden="true">↗</span></a><a href="/rules" aria-current={Astro.url.pathname === '/rules' ? 'page' : undefined}>Complete rules</a><a href="/scoring" aria-current={Astro.url.pathname === '/scoring' ? 'page' : undefined}>Scoring explained</a><a href="/cards" aria-current={Astro.url.pathname === '/cards' ? 'page' : undefined}>Meet the deck</a></nav><p class="small">Our reference game: traditional two-player Scopa, played to 11.</p><slot name="aside" /></aside><article class="prose"><slot /></article></div>
</BaseLayout>
